+    // Homogeneous floating-point aggregate (Vector3, Color, Quaternion...).
+    // AAPCS64 targets (Android) pass and return these in v registers, so the
+    // native type must be a real float/double aggregate, not a byte array.
+    template <typename E, size_t N>
+    struct Hfa
+    {
+        E e[N];
+    };
+
+    template <typename T>
+    inline uint8_t* BytesOf(T& value) { return reinterpret_cast<uint8_t*>(&value); }
+
     // Guest stack of the current thread. Entry thunks start below the stack
     // pointer that was current when guest code last called into native code,
     // so nested native -> guest -> native -> guest calls never overlap.
