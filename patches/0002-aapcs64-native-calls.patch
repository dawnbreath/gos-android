diff --git a/recomp/android/aapcs_call.S b/recomp/android/aapcs_call.S
new file mode 100644
index 0000000..f76d16e
--- /dev/null
+++ b/recomp/android/aapcs_call.S
@@ -0,0 +1,46 @@
+// void recomp_aapcs_call(recomp::Ctx* c, void* target, const void* stack, size_t stackBytes)
+//
+// Calls a native AAPCS64 function with the guest register file: x0-x8 and
+// q0-q7 are loaded from the Ctx, `stackBytes` of already laid-out stack
+// arguments are copied to the native stack, and x0/x1 and q0-q3 (integer,
+// pair, HFA results) are written back. Ctx layout: x[31] at 0, sp at 248,
+// v[32] (16 bytes each) at 256.
+    .text
+    .p2align 2
+    .global recomp_aapcs_call
+    .type recomp_aapcs_call, %function
+recomp_aapcs_call:
+    stp     x29, x30, [sp, #-32]!
+    mov     x29, sp
+    stp     x19, x20, [sp, #16]
+    mov     x19, x0
+    mov     x20, x1
+    add     x9, x3, #15
+    and     x9, x9, #~15
+    sub     sp, sp, x9
+    mov     x10, #0
+1:  cmp     x10, x3
+    b.hs    2f
+    ldrb    w11, [x2, x10]
+    strb    w11, [sp, x10]
+    add     x10, x10, #1
+    b       1b
+2:  ldp     q0, q1, [x19, #256]
+    ldp     q2, q3, [x19, #288]
+    ldp     q4, q5, [x19, #320]
+    ldp     q6, q7, [x19, #352]
+    ldr     x8, [x19, #64]
+    ldp     x6, x7, [x19, #48]
+    ldp     x4, x5, [x19, #32]
+    ldp     x2, x3, [x19, #16]
+    ldp     x0, x1, [x19, #0]
+    blr     x20
+    stp     x0, x1, [x19, #0]
+    stp     q0, q1, [x19, #256]
+    stp     q2, q3, [x19, #288]
+    mov     sp, x29
+    ldp     x19, x20, [sp, #16]
+    ldp     x29, x30, [sp], #32
+    ret
+    .size recomp_aapcs_call, .-recomp_aapcs_call
+    .section .note.GNU-stack, "", %progbits
