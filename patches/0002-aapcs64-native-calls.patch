diff --git a/recomp/winbuild/icall_marshal.cpp b/recomp/winbuild/icall_marshal.cpp
index 7753cfb..7354c21 100644
--- a/recomp/winbuild/icall_marshal.cpp
+++ b/recomp/winbuild/icall_marshal.cpp
@@ -27,6 +27,10 @@
 #include "recomp_bridge.h"
 #include "recomp_ctx.h"
 
+#ifndef _WIN32
+extern "C" void recomp_aapcs_call(recomp::Ctx* c, void* target, const void* stack, size_t stackBytes);
+#endif
+
 namespace recomp
 {
     namespace
@@ -179,6 +183,7 @@ namespace recomp
             return nullptr;
         }
 
+#ifdef _WIN32
         // --- Win64 dynamic call: the first four positions may be float or
         // double (xmm), everything else travels as 64-bit integers ---
         template <Kind K> struct Host { using T = uint64_t; static T From(uint64_t b) { return b; } };
@@ -354,6 +359,59 @@ namespace recomp
             }
             return true;
         }
+    
+#else  // AAPCS64 host (Android): same register convention as the game.
+        constexpr int kMaxArgs = 32;
+
+        // Apple packs stack arguments at their natural size and alignment;
+        // AAPCS64 gives each one an 8-byte slot. Registers are passed as is.
+        bool TypedCall(Ctx& c, uint64_t target)
+        {
+            Signature sig;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                auto it = Signatures().find(target);
+                if (it == Signatures().end())
+                    return false;
+                sig = it->second;
+            }
+            if (sig.args.size() > size_t(kMaxArgs))
+                return false;
+            alignas(16) uint8_t stack[8 * kMaxArgs] = {};
+            size_t used = 0;
+            int ngrn = 0, nsrn = 0;
+            uint64_t src = c.sp;
+            for (const Arg& arg : sig.args)
+            {
+                bool fp = arg.kind == Kind::F32 || arg.kind == Kind::F64;
+                if (fp ? nsrn < 8 : ngrn < 8)
+                {
+                    (fp ? nsrn : ngrn)++;
+                    continue;
+                }
+                src = (src + arg.size - 1) & ~uint64_t(arg.size - 1);
+                memcpy(stack + used, reinterpret_cast<const void*>(src), arg.size);
+                src += arg.size;
+                used += 8;
+            }
+            SetGuestStackPointer(c.sp);
+            recomp_aapcs_call(&c, reinterpret_cast<void*>(target), stack, used);
+            if (sig.ret == Kind::Int)
+            {
+                // AAPCS64 leaves the bits above a narrow result unspecified
+                uint64_t r = c.x[0];
+                switch (sig.retSize)
+                {
+                case 1: r = sig.retSigned ? uint64_t(int64_t(int8_t(r))) : uint8_t(r); break;
+                case 2: r = sig.retSigned ? uint64_t(int64_t(int16_t(r))) : uint16_t(r); break;
+                case 4: r = sig.retSigned ? uint64_t(int64_t(int32_t(r))) : uint32_t(r); break;
+                default: break;
+                }
+                c.x[0] = r;
+            }
+            return true;
+        }
+#endif
     }
 
     // Records the signature of an icall the game just resolved by name.
